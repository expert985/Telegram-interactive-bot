# ==================== 数据库配置 ====================
# MySQL 8.0.36 数据库配置
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=telegram
MYSQL_PASSWORD=telegram123
MYSQL_DATABASE=telegram_customer
MYSQL_ROOT_PASSWORD=root123  # root 用户密码（Docker 使用）

# Redis 连接 URL
REDIS_URL=redis://localhost:6379

# ==================== API 服务配置 ====================
# API 服务绑定地址和端口
API_HOST=0.0.0.0
API_PORT=8000

# JWT 认证密钥（生产环境务必修改！）
JWT_SECRET=your-super-secret-key-change-in-production-!!!

# ==================== Telegram 默认 API 凭证 ====================
# 默认使用官方 API 凭证，也可以使用自己的
# 在 https://my.telegram.org/apps 获取
DEFAULT_API_ID=6
DEFAULT_API_HASH=eb06d4abfb49dc3eeb1aeb98ae0f581e

# ==================== 前端配置 ====================
# 前端访问地址（用于 CORS）
FRONTEND_URL=http://localhost:3000

# ==================== 日志配置 ====================
LOG_LEVEL=INFO  # DEBUG | INFO | WARNING | ERROR

# ==================== 其他配置 ====================
# 会话锁定时长（秒）
SESSION_LOCK_DURATION=300

# 消息缓存时长（秒）
MESSAGE_CACHE_TTL=3600
